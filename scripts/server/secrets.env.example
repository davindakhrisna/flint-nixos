# ==============================================================================
# Homelab Secrets Configuration
# Copy this file to .secrets.env or secrets.env and fill in your credentials:
#   cp secrets.env.example .secrets.env
#   chmod 600 .secrets.env
# ==============================================================================

# User Account & Authentication
USERNAME="kryisnn"
PASSWORD=""
EMAIL="kryisnn@homelab.local"

# Optional 9Router initial dashboard password; defaults to PASSWORD when empty.
INITIAL_PASSWORD=""

# Hermes inference through the local 9Router endpoint
CUSTOM_BASE_URL="http://localhost:20128/v1"
OPENAI_BASE_URL="http://localhost:20128/v1"
# Set OPENAI_API_KEY to your 9Router key; models live in config/hermes/_settings.nix.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# WhatsApp uses a second (bot) number; enable after QR pairing succeeds.
WHATSAPP_ENABLED="false"
WHATSAPP_MODE="bot"
WHATSAPP_ALLOWED_USERS="your-country-code-and-phone-number"
WHATSAPP_ALLOW_ALL_USERS="false"
WHATSAPP_DM_POLICY="allowlist"
WHATSAPP_GROUP_POLICY="disabled"
